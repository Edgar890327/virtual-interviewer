# --- PostgreSQL ---
POSTGRES_DB=interviewdb
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview_secret
DATABASE_URL=postgresql://interview:interview_secret@localhost:5432/interviewdb

# --- Application ---
JWT_SECRET_KEY=your-secret-key-change-in-production

# --- Local Model (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=your-ollama-api-key-change-in-production

# --- Whisper STT ---
WHISPER_MODEL_SIZE=small

# CPU mode (default docker-compose.yml)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# GPU mode suggestion (docker-compose.gpu.yml)
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
